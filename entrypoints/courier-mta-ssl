#!/bin/bash
# Fixed certificate path issue 2025-06-29
set -e -x -o pipefail

# context.json is added via the docker/container as a bind mount
/render-template --context /context.json --template /esmtpd-base-mta-ssl.template > /etc/courier/esmtpd
/render-template --context /context.json --template /esmtpd-mta-ssl.template > /etc/courier/esmtpd-ssl

# Generate authdaemonrc configuration file
/render-template --context /context.json --template /authdaemonrc.template > /etc/authlib/authdaemonrc


# Cert and key are read directly from the mounted cert-manager Secret via
# TLS_CERTFILE and TLS_PRIVATE_KEYFILE. Nothing copies or combines them, so a
# renewed certificate is picked up on the next connection.

# The derived databases are built out of band and mounted read-only; this pod
# does not build them. Prove they are usable before starting anything, so a
# missing or empty database is a startup failure rather than every lookup
# quietly returning "no such user".
/usr/local/bin/assert-courier-dat /etc/courier/hosteddomains.dat /etc/courier/esmtpacceptmailfor.dat /etc/courier/smtpaccess.dat /etc/courier/aliases.dat=0 /etc/authlib/userdb.dat /etc/authlib/userdbshadow.dat

# Hand off to runit. It supervises the listener and the auth daemon as separate
# services in this one namespace, and runsvdir becomes PID 1, so a daemon's
# death is the container's death rather than something an in-container loop
# papers over.
#
# What this replaces started each daemon detached and polled for it every 10s.
# Such a loop restarts forever and tells Kubernetes nothing: the pod reports
# Running, the restart count stays 0, and a smoke test asserting "all pods
# Running" passes straight through an outage. Its process match was also loose
# enough to catch the start wrapper and courierlogger, not just the listener.
# The auth daemon was supervised by nothing at all.
exec runsvdir /etc/service
