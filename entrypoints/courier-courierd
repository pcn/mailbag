#!/bin/bash

set -e -x -o pipefail

# Ensure the directory structure is in place for courier operation
mkdir -p /var/spool/courier/{msgq,msgs,track,tmp,filters,allfilters}
chown -R daemon:daemon /var/spool/courier/{msgq,msgs,track,tmp,filters,allfilters}
chmod 750 /var/spool/courier/{msgq,msgs,filters,allfilters}
chmod 770 /var/spool/courier/tmp
chmod 755 /var/spool/courier/track

# courierd decides local-versus-remote itself. libs/islocal.c reads
# hosteddomains.dat, and module.esmtp/esmtp.c reads esmtpacceptmailfor.dat --
# both inside THIS container, in the delivery agents courierd spawns
# (courierlocal, courieresmtp). Without them courierd treats every domain as
# remote and hands local mail to courieresmtp for outbound SMTP, which loops
# straight back into our own port 25.
#
# These are rendered here rather than read from the shared /etc/courier volume
# on purpose. Mounting that volume would make courierd depend on some listener
# having started first and run makehosteddomains, which is an ordering race with
# nothing to enforce it, and it would mask this image's own configuration. Both
# files are pure functions of context.json, which is already mounted, so
# courierd can just build its own and share nothing.
mkdir -p /etc/courier/esmtpacceptmailfor.dir
/render-template --context /context.json --template /acceptmailfor.template > /etc/courier/esmtpacceptmailfor.dir/context
/render-template --context /context.json --template /hosteddomains.template > /etc/courier/hosteddomains
/usr/lib/courier/share/makeacceptmailfor
/usr/lib/courier/share/makehosteddomains

# courierlocal resolves virtual users through authlib
# (module.local/local.c calls auth_getuserinfo), so courierd needs an
# authdaemond of its own. It cannot borrow another container's: the socket path
# is a compile-time constant (AUTHDAEMONSOCK in courier-authlib/Makefile.am),
# so every container's socket is container-local regardless of what
# authdaemonvar says in authdaemonrc. That also means there is no collision to
# worry about here.
/rebuild-userdb
/usr/sbin/authdaemond start

# Use the same environment setup as courierctl.start but run in foreground
cd /usr/lib/courier
exec /usr/bin/env -i /bin/bash -c "set -a ; . /etc/courier/courierd; exec /usr/lib/courier/libexec/courier/courierd"
