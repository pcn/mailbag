#!/bin/bash
#
# Kubernetes readiness/liveness probe. Two independent assertions:
#
#   1. Every supervised service is up, per runit itself (`sv check`). This is
#      what surfaces supervisor state to Kubernetes -- without it a container
#      whose auth daemon is crashlooping still looks healthy, because the
#      listener it sits behind is answering fine.
#
#   2. If a port is given, the service speaks its protocol -- connect and read
#      the greeting.
#
# (2) is deliberately not a tcpSocket probe. A listener wedged with SIGSTOP
# keeps its listen socket open and the kernel keeps completing handshakes into
# the backlog, so a bare TCP connect succeeds against a process that will never
# answer; verified on the running MTA, where connect succeeded while the SMTP
# banner timed out.
#
# Usage: mailbag-probe [--port N --expect PREFIX [--tls]]
set -u

port=""; expect=""; tls=0
while [ $# -gt 0 ]; do
    case "$1" in
        --port)   port=${2:?--port needs a value}; shift 2 ;;
        --expect) expect=${2:?--expect needs a value}; shift 2 ;;
        --tls)    tls=1; shift ;;
        *) echo "probe: unknown argument '$1'" >&2; exit 2 ;;
    esac
done

timeout_s=${PROBE_TIMEOUT:-5}

# (1) supervisor state
found=0
for svc in /etc/service/*; do
    # Directories (or symlinks to them) only. A stray file in the service
    # directory is not a service, and `sv check` on one fails -- which would
    # fail the probe for something that has nothing to do with service health.
    [ -d "$svc" ] || continue
    found=1
    # Parse `sv status` rather than trust `sv check`. Both exit 0 for a service
    # that is deliberately stopped -- `sv check` asks whether the service is in
    # the state that was *requested*, so `sv down` makes it succeed:
    #
    #   up   -> "run: /etc/service/x: (pid 10) 3s"           check exit 0
    #   down -> "down: /etc/service/x: 2s, normally up"      check exit 0
    #
    # Only the "run:" prefix means the service is actually running.
    status=$(sv status "$svc" 2>&1)
    case "$status" in
        run:*) ;;
        *) echo "probe: service $(basename "$svc") is not running: $status" >&2
           exit 1 ;;
    esac
done

# An empty service directory means runit is supervising nothing, which is not
# health -- without this the loop above would pass vacuously.
if [ "$found" = 0 ]; then
    echo "probe: no services found in /etc/service" >&2
    exit 1
fi

# (2) protocol greeting
[ -n "$port" ] || exit 0
: "${expect:?--port requires --expect}"

if [ "$tls" = 1 ]; then
    # -ign_eof, emphatically not -no_ign_eof. The latter makes s_client close as
    # soon as stdin hits EOF, which with </dev/null is immediately -- the TLS
    # handshake completes and the connection is torn down before the server's
    # greeting is read, so the probe reports "no greeting" against a perfectly
    # healthy service. head -1 closes the pipe once the greeting arrives, and
    # timeout bounds the wait.
    #
    # No -verify_return_error: this probes the service, not the chain, and must
    # not start failing when the deployment uses a locally generated test CA.
    greeting=$(timeout "$timeout_s" openssl s_client -connect "127.0.0.1:$port" \
        -quiet -ign_eof </dev/null 2>/dev/null | head -1)
else
    greeting=$(timeout "$timeout_s" bash -c "
        exec 3<>/dev/tcp/127.0.0.1/$port || exit 1
        head -1 <&3" 2>/dev/null)
fi
greeting=${greeting%$'\r'}

case "$greeting" in
    "$expect"*) exit 0 ;;
    "") echo "probe: no greeting from port $port within ${timeout_s}s" >&2; exit 1 ;;
    *)  echo "probe: port $port said '${greeting}', expected '${expect}'*" >&2; exit 1 ;;
esac
