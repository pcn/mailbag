#!/bin/sh
#
# Supervised courier listener. Takes the name of the start script under
# /usr/lib/courier/sbin, e.g. `sv-run-courier esmtpd`.
#
# The start scripts already run in the foreground: the Dockerfiles strip
# `-pid=$PIDFILE`, and without a pidfile the script's final
# `( ... ) | /usr/bin/env -i /bin/bash` blocks until couriertcpd exits. So
# exec'ing it gives runit a process whose death is the service's death.
set -u

name=${1:?usage: sv-run-courier <courier-start-script>}
svc=$(basename "$(pwd)")

mkdir -p /run/mailbag-sv
date +%s > "/run/mailbag-sv/$svc.started"

# Wait for the auth daemon rather than race it. runsvdir starts every service at
# once, and a listener that comes up first and fails would otherwise burn
# entries off sv-finish's crashloop tally for what is just startup ordering.
socket=/var/spool/authdaemon/socket
waited=0
while [ ! -S "$socket" ] && [ "$waited" -lt "${SV_AUTH_WAIT:-30}" ]; do
    sleep 1
    waited=$(( waited + 1 ))
done
if [ ! -S "$socket" ]; then
    echo "sv-run-courier: $socket did not appear in ${waited}s; starting anyway" >&2
fi

exec 2>&1
# chpst -P puts this service in its own process group, and $$ survives the exec
# below, so it is also the group leader's pid. sv-finish kills that whole group.
#
# Without it, courier's start script leaves the real listener behind on restart:
# runsv signals only the run process, but couriertcpd lives in a nested subshell,
# so it is orphaned onto runsvdir and keeps holding the port. The replacement
# then finds the port bound and exits 0 immediately -- every restart crashlooped
# straight to a container exit. Reproduced on both the mta and imapd-ssl images.
echo $$ > "/run/mailbag-sv/$svc.pgid"

# couriertcpd puts itself in its own process group (observed: pid 91, pgid 91),
# so the group kill above cannot reach it and it survives holding the port.
# Declare it here so sv-finish reaps it by name. Scoped deliberately: each
# container runs exactly one listener, and the auth daemon must not match.
echo "^/usr/lib/courier/sbin/couriertcpd" > "/run/mailbag-sv/$svc.cleanup"

exec chpst -P "/usr/lib/courier/sbin/$name" start
