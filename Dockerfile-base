# Overridden by the build workflow with the exact upstream built in the same
# run, so the base is never assembled from a half-updated dependency set.
# The :main default keeps a plain `docker build` working locally.
ARG PACKAGES_IMAGE=ghcr.io/pcn/mailbag-packages:main

# export-stage is the packaged .debs for the courier components
FROM ${PACKAGES_IMAGE} AS packages
FROM ubuntu:noble

# The template renderer is upstream minijinja-cli, installed as /renderer. Its
# version and checksums are pinned in examples/example-context.json
# (.tools.minijinja_cli) and passed in by the build workflow. There are no
# defaults on purpose: a default here would be a second pin that could drift
# from the context, so a build without them fails instead.
ARG MINIJINJA_CLI_VERSION
ARG MINIJINJA_CLI_SHA256_X86_64
ARG MINIJINJA_CLI_SHA256_AARCH64


COPY --from=packages /export /tmp/p

ENV TZ=UTC

RUN apt-get update && apt-get install -y tzdata
RUN ln -snf /usr/share/zoneinfo/UTC /etc/localtime && echo UTC > /etc/timezone

RUN apt-get update  ; apt install -y less
RUN groupadd -g 300 vmail; useradd -M -r -d /opt/vmail -u 300 -g vmail vmail

RUN apt-get install -y locales bzip2 curl xz-utils && echo "LANG=en_US.UTF-8" > /etc/default/locale

# --strict -n at every call site: printing an undefined value is an error, and
# the output carries no added trailing newline.
RUN set -eu; \
    test -n "${MINIJINJA_CLI_VERSION:-}" || { echo "MINIJINJA_CLI_VERSION not set" >&2; exit 1; }; \
    case "$(uname -m)" in \
      x86_64)  target=x86_64-unknown-linux-gnu;  sha256="${MINIJINJA_CLI_SHA256_X86_64:-}" ;; \
      aarch64) target=aarch64-unknown-linux-gnu; sha256="${MINIJINJA_CLI_SHA256_AARCH64:-}" ;; \
      *) echo "no minijinja-cli target for $(uname -m)" >&2; exit 1 ;; \
    esac; \
    test -n "$sha256" || { echo "no minijinja-cli sha256 for $target" >&2; exit 1; }; \
    cd /tmp; \
    curl -fsSL -o mj.tar.xz "https://github.com/mitsuhiko/minijinja/releases/download/${MINIJINJA_CLI_VERSION}/minijinja-cli-${target}.tar.xz"; \
    echo "${sha256}  mj.tar.xz" | sha256sum -c -; \
    tar -xJf mj.tar.xz; \
    install -m 0755 "minijinja-cli-${target}/minijinja-cli" /renderer; \
    rm -rf mj.tar.xz "minijinja-cli-${target}"; \
    /renderer --version | grep -qx "minijinja-cli ${MINIJINJA_CLI_VERSION}"

# The packages now come from the packages image via the COPY above, not from a
# release tarball. The commented-out curl that used to fetch one ended in a
# backslash, and a comment carrying a line continuation joins to the next real
# instruction -- so it was silently swallowing `RUN ls /tmp/p`. Harmless only
# because that line is a debug listing; the same shape broke the mta-ssl build
# by eating a COPY. Comment lines here must not end in a backslash.
RUN ls /tmp/p
# Remove packages that we don't want, and install all of the remaining packages.
RUN cd /tmp/p; rm -f *web* *pop3* *mysql* *auth*pgsql* *auth*pipe* *ldap* *fax* *-dev* && \
  rm -f *mlm* && \
  apt install -y ./*.deb && \
  rm -f *.deb

# sed -i<suffix> takes the suffix with no separator, so `-idist` wrote the
# backup as authdaemonrcdist rather than authdaemonrc.dist -- inconsistent
# with every other config, and invisible to anything looking for *.dist.
RUN cd /etc/authlib; sed -i.dist 's/^authmodulelist="authuserdb /authmodulelist="authuserdb"  #/g' authdaemonrc
# runit supervises the two daemons every service image runs -- the listener and
# its auth daemon -- inside one container, so they share a namespace and can see
# each other. --no-install-recommends matters: the sysv/systemd init integration
# lives in the separate runit-run and runit-init packages, which are Recommends,
# and apt would otherwise pull init machinery into a container that has no use
# for it. The runit package itself is just the binaries (runsvdir, runsv, sv,
# chpst, svlogd) and depends only on libc6 and sysuser-helper.
RUN apt-get update && apt-get install -y --no-install-recommends runit

# Service directories live in /etc/sv and are enabled by symlink into
# /etc/service. Debian's own service machinery ignores these: its postinst
# trigger skips any directory without a .meta/bin marker, which hand-written
# ones do not have.
COPY entrypoints/sv/ /usr/local/lib/mailbag-sv/
COPY scripts/validate-courier-dat.pl /usr/local/bin/validate-courier-dat.pl
# The build script ships in the service images because the build job runs as
# one of them: they are what carry makedat, makealiases and makeuserdb.
COPY scripts/build-courier-dat.sh /usr/local/bin/build-courier-dat.sh
COPY scripts/userdb-source.sh /usr/local/bin/userdb-source.sh
RUN chmod 0755 /usr/local/bin/validate-courier-dat.pl /usr/local/bin/build-courier-dat.sh \
               /usr/local/bin/userdb-source.sh
RUN install -m 0755 /usr/local/lib/mailbag-sv/sv-finish /usr/local/bin/sv-finish && \
    install -m 0755 /usr/local/lib/mailbag-sv/sv-run-courier /usr/local/bin/sv-run-courier && \
    install -m 0755 /usr/local/lib/mailbag-sv/sv-run-courierd /usr/local/bin/sv-run-courierd && \
    install -m 0755 /usr/local/lib/mailbag-sv/mailbag-probe /usr/local/bin/mailbag-probe && \
    install -m 0755 /usr/local/lib/mailbag-sv/assert-courier-dat /usr/local/bin/assert-courier-dat && \
    # runsv creates supervise/ inside each service directory, and the state dir
    # is written by the run and finish scripts -- both as whatever user the
    # container runs as. mta, msa and mta-ssl run as daemon(1), so these must
    # be group-writable or runsv dies with "unable to open supervise/lock".
    # The run and finish scripts themselves stay root-owned and non-writable.
    install -d -m 0775 -o root -g daemon /etc/sv/authdaemon /run/mailbag-sv && \
    install -d /etc/service && \
    install -m 0755 /usr/local/lib/mailbag-sv/sv-run-authdaemon /etc/sv/authdaemon/run && \
    ln -sf /usr/local/bin/sv-finish /etc/sv/authdaemon/finish && \
    ln -sf /etc/sv/authdaemon /etc/service/authdaemon && \
    rm -rf /usr/local/lib/mailbag-sv

ENTRYPOINT ["/usr/bin/tail", "-f", "/dev/null"]
