package mailbag

import (
	"list"
	"strings"
)

// The target state of a mailbag k3s host (PROJ-026), computed from the host
// block of a validated context. Pure: no tasks. #Plan compares it with what is
// on the host, and the cue cmd workflows in host_tool.cue apply the result.

// The files host setup manages, and the k3s data location it refuses to
// migrate from.
#Paths: {
	configDir:  "/etc/rancher/k3s"
	config:     configDir + "/config.yaml"
	dropinDir:  "/etc/systemd/system/k3s.service.d"
	dropin:     dropinDir + "/10-gomemlimit.conf"
	env:        "/etc/environment"
	oldDataDir: "/var/lib/rancher/k3s"
	// Log limits (PROJ-044). The journald drop-in keeps the name farout's
	// hand-made one had, so the first apply replaces it rather than leaving a
	// second file that sorts after ours.
	journaldDir: "/etc/systemd/journald.conf.d"
	journald:    journaldDir + "/99-size-cap.conf"
	logrotateDir: "/etc/logrotate.d"
	logrotate:    logrotateDir + "/rsyslog"
}

// #Paths under a prefix: "" on a real host, a scratch directory when testing
// the tool layer. The tool layer reads these and #Plan writes them, so both
// take them from here.
#Rooted: {
	root: *"" | =~"^/.*[^/]$"
	paths: {for k, v in #Paths {(k): root + v}}
}

// What a correctly set-up host holds, given its host block as `in`.
#Desired: {
	in: #Host
	let k = in.k3s

	version: k.version
	// '+' in the tag must be escaped in the URL path.
	installURL:    "https://raw.githubusercontent.com/k3s-io/k3s/\(strings.Replace(k.version, "+", "%2B", -1))/install.sh"
	installSha256: k.install_sha256

	envLine: "K3S_DATA_DIR=\(k.data_dir)"

	// cert-manager's static release manifest (PROJ-027).
	certManager: {
		version:     in.cert_manager.version
		manifestURL: "https://github.com/cert-manager/cert-manager/releases/download/\(version)/cert-manager.yaml"
		sha256:      in.cert_manager.manifest_sha256
	}

	// Why each component is disabled, for the ones mailbag knows about. A
	// component not listed here is still disabled, without a comment.
	let why = {
		traefik: """
			  # No Ingress in mailbag: the services are raw SMTP/IMAP on their own
			  # ports, and the certificate is issued over DNS-01, which needs none.
			"""
		"metrics-server": """
			  # Nothing consumes metrics here; no HPA, no kubectl top in the test flow.
			"""
		"local-storage": """
			  # The workloads use hostPath volumes and never ask for dynamic
			  # provisioning, so the local-path provisioner is dead weight.
			"""
	}
	let disableBlock = [
		if len(k.disable) == 0 {"disable: []"},
		strings.Join(list.Concat([["disable:"], [for c in k.disable {
			[if why[c] != _|_ {why[c] + "\n  - \(c)"}, "  - \(c)"][0]
		}]]), "\n"),
	][0]

	config: """
		# Generated by mailbag host setup (cue cmd apply, PROJ-026) from host.k3s
		# in /etc/mailbag/context.json. The next apply reverts any hand edit.
		#
		# Trimmed for a small VM: every component disabled here is unused by
		# mailbag or costs more than it earns at this memory budget.
		\(disableBlock)

		# servicelb is deliberately KEPT: all four mailbag Services are type
		# LoadBalancer on real ports (25/465/587/993). Without klipper-lb they would
		# sit Pending forever, and NodePort cannot serve those ports directly.

		# mailbag defines no NetworkPolicy, so the kube-router policy controller is
		# pure overhead.
		disable-network-policy: true
		# No HelmChart CRs exist to reconcile.
		disable-helm-controller: true

		# k3s state and images live on the large filesystem rather than the small
		# /var, which filled up and triggered DiskPressure evictions (PROJ-024).
		# k3s-killall.sh and k3s-uninstall.sh read K3S_DATA_DIR instead, set in
		# /etc/environment.
		data-dir: \(k.data_dir)

		"""

	dropin: """
		# Generated by mailbag host setup (cue cmd apply, PROJ-026) from
		# host.k3s.gomemlimit. The next apply reverts any hand edit.
		[Service]
		# Soft heap target for the Go runtime: GC works harder as the heap nears it,
		# returning memory to the OS instead of holding it. It is not a hard cap --
		# if live data exceeds it, k3s keeps running and spends more CPU on GC.
		Environment=GOMEMLIMIT=\(k.gomemlimit)

		"""

	// Log limits on the small /var (PROJ-044).
	let j = in.logs.journald
	journald: """
		# Generated by mailbag host setup (cue cmd apply, PROJ-044) from
		# host.logs.journald in /etc/mailbag/context.json. The next apply reverts
		# any hand edit.
		#
		# /var is small, and journald's default cap (10% of the filesystem) let the
		# journal crowd it. Cap it explicitly.
		[Journal]
		SystemMaxUse=\(j.system_max_use)
		SystemMaxFileSize=\(j.system_max_file_size)
		MaxRetentionSec=\(j.max_retention)

		"""

	let r = in.logs.rsyslog
	// Debian's rule for rsyslog's logs, with frequency, rotate and maxsize
	// from the context. delaycompress is dropped, so a rotated log is
	// compressed at once rather than sitting uncompressed on /var for a cycle.
	logrotate: """
		# Generated by mailbag host setup (cue cmd apply, PROJ-044) from
		# host.logs.rsyslog in /etc/mailbag/context.json. The next apply reverts
		# any hand edit. This replaces Debian's rsyslog conffile, so dpkg reports
		# it modified; keep it if an rsyslog upgrade asks.
		/var/log/syslog
		/var/log/mail.log
		/var/log/kern.log
		/var/log/auth.log
		/var/log/user.log
		/var/log/cron.log
		{
		\trotate \(r.rotate)
		\t\(r.frequency)
		\tmaxsize \(r.maxsize)
		\tmissingok
		\tnotifempty
		\tcompress
		\tsharedscripts
		\tpostrotate
		\t\t/usr/lib/rsyslog/rsyslog-rotate
		\tendscript
		}

		"""
}

// /etc/environment is shared with the rest of the system, so host setup owns
// one line in it, not the file. Given its current text ("" when missing),
// `out` is the text with our line set: an existing line for the key is
// replaced where it stands (later duplicates dropped), otherwise ours is
// appended. Every other line, and their order, is kept.
#EnvEdit: {
	text: string
	key:  string
	line: string

	let lines = strings.Split(text, "\n")
	let hits = [for i, l in lines if strings.HasPrefix(l, key+"=") {i}]

	out: string
	if len(hits) == 0 {
		// Keep the file newline-terminated however it ended.
		out: [
			if text == "" || strings.HasSuffix(text, "\n") {text + line + "\n"},
			text + "\n" + line + "\n",
		][0]
	}
	if len(hits) > 0 {
		let dups = list.Slice(hits, 1, len(hits))
		out: strings.Join([for i, l in lines if !list.Contains(dups, i) {
			[if i == hits[0] {line}, l][0]
		}], "\n")
	}
}
