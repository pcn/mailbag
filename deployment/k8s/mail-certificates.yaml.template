# The mail certificate, issued by the letsencrypt ClusterIssuer
# (letsencrypt-clusterissuer.yaml.template) into the Secret every service
# mounts at /certs. Applied by deploy-services.sh when tls.source is
# cert-manager.
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: courier-mail-cert
  namespace: {{ services.k8s_namespace }}
spec:
  secretName: courier-mail-cert-tls
  issuerRef:
    name: letsencrypt
    kind: ClusterIssuer
  # Every name a service answers on, once each: hosts commonly point several
  # services at one name, and a repeated dnsName is an invalid order.
  dnsNames:
{%- for name in [domain.zone, mta.dns_name, msa.dns_name, mta_ssl.dns_name, imapd_ssl.dns_name] | unique %}
  - {{ name }}
{%- endfor %}
