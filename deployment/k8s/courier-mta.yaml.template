apiVersion: apps/v1
kind: Deployment
metadata:
  name: courier-mta
  namespace: mailbag
  labels:
    app: mailbag
    component: mta
spec:
  replicas: 1
  # Recreate: this node has no headroom for a surge replica.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: mailbag
      component: mta
  template:
    metadata:
      labels:
        app: mailbag
        component: mta
    spec:
      securityContext:
        fsGroup: 1
        fsGroupChangePolicy: OnRootMismatch
      initContainers:
      - name: init-dirs
        # Pinned by digest: an init container that runs as root and chowns the mail
        # store is not somewhere to accept a mutable upstream tag.
        image: busybox:1.37.0@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0
        command: 
        - sh
        - -c
        - |
          mkdir -p /etc/courier/esmtpacceptmailfor.dir
          mkdir -p /etc/authlib/userdb
          chmod 700 /etc/authlib/userdb
          chown -R daemon:daemon /etc/courier
          chown -R daemon:daemon /etc/authlib
        volumeMounts:
        - name: courier-config
          mountPath: /etc/courier
        - name: courier-auth
          mountPath: /etc/authlib
        securityContext:
          runAsUser: 0
      containers:
      - name: courier-mta
        image: ghcr.io/pcn/mailbag/courier-mta:{{ image.tag | default("main") }}
        imagePullPolicy: Always
        ports:
        - containerPort: 25
          name: smtp
        volumeMounts:
        - name: courier-spool
          mountPath: /var/spool/courier
        - name: mail-storage
          mountPath: /vmail
        - name: courier-config
          mountPath: /etc/courier
        - name: courier-auth
          mountPath: /etc/authlib
        - name: courier-cert
          mountPath: /certs
          readOnly: true
        - name: context-json
          mountPath: /context.json
          readOnly: true
        - name: templates
          mountPath: /acceptmailfor.template
          subPath: acceptmailfor.template
        - name: templates
          mountPath: /hosteddomains.template
          subPath: hosteddomains.template
        readinessProbe:
          exec:
            command: ["/bin/sh", "-c", '/usr/local/bin/mailbag-probe --port 25 --expect "220"']
          initialDelaySeconds: 10
          periodSeconds: 10
          timeoutSeconds: 10
          failureThreshold: 3
        livenessProbe:
          exec:
            command: ["/bin/sh", "-c", '/usr/local/bin/mailbag-probe --port 25 --expect "220"']
          initialDelaySeconds: 60
          periodSeconds: 30
          timeoutSeconds: 10
          # Higher than readiness on purpose: readiness should pull the pod out
          # of the Service quickly, but restarting is the heavier hammer and
          # runit is already retrying underneath.
          failureThreshold: 5
        securityContext:
          runAsUser: 1
          runAsGroup: 1
      volumes:
      - name: courier-spool
        persistentVolumeClaim:
          claimName: courier-spool-pvc
      - name: mail-storage
        persistentVolumeClaim:
          claimName: mail-storage-pvc
      - name: courier-config
        persistentVolumeClaim:
          claimName: courier-config-pvc
      - name: courier-auth
        persistentVolumeClaim:
          claimName: courier-auth-pvc
      - name: courier-cert
        secret:
          secretName: courier-mail-cert-tls
          # Readable by the service group, never world-readable. Ownership comes
          # from the pod fsGroup below; Secret volumes are root-owned otherwise.
          defaultMode: 0440
      - name: context-json
        hostPath:
          path: /etc/mailbag/context.json
          type: File
      - name: templates
        configMap:
          name: mailbag-context
---
apiVersion: v1
kind: Service
metadata:
  name: mta
  namespace: mailbag
  labels:
    app: mailbag
    component: mta
spec:
  selector:
    app: mailbag
    component: mta
  ports:
  - port: 25
    targetPort: smtp
    protocol: TCP
    name: smtp
  type: LoadBalancer
