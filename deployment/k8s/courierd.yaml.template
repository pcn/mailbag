apiVersion: apps/v1
kind: Deployment
metadata:
  name: courierd
  namespace: mailbag
  labels:
    app: mailbag
    component: courierd
spec:
  replicas: 1
  # courierd takes an exclusive lock on the shared spool
  # (/var/spool/courier/tmp/courierd.lock), so a second instance exits
  # immediately. RollingUpdate keeps the old pod until the new one is Ready, so
  # the new one can never become Ready -- it exits 0 and crash-loops. Recreate
  # is a correctness requirement here, not a preference.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: mailbag
      component: courierd
  template:
    metadata:
      labels:
        app: mailbag
        component: courierd
    spec:
      initContainers:
      - name: init-dirs
        # Pinned by digest: an init container that runs as root and chowns the mail
        # store is not somewhere to accept a mutable upstream tag.
        image: busybox:1.37.0@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0
        command: 
        - sh
        - -c
        - |
          set -e
          # busybox sh has no brace expansion: the subdirectories are spelled
          # out. A "{msgq,msgs,...}" directory left by the old form is removed.
          S=/var/spool/courier
          rm -rf "$S/{msgq,msgs,track,tmp,filters,allfilters}"
          mkdir -p $S/msgq $S/msgs $S/track $S/tmp $S/filters $S/allfilters
          chmod 755 $S $S/track
          chmod 750 $S/msgq $S/msgs $S/filters $S/allfilters
          chmod 770 $S/tmp
          chown -R daemon:daemon $S
          # The mail root only, never recursively: the domain and maildir
          # trees below it belong to vmail and to account handling.
          chown root:root /vmail
          chmod 755 /vmail
          # A maildir for every declared mailbox that lacks one (PROJ-040).
          # Creates only what is missing and never changes or removes an
          # existing directory: a mailbox removed from the context keeps its
          # mail. vmail is 300.
          mkmaildir() {
            d=/vmail/$1 u=/vmail/$1/$2
            if [ ! -d "$d" ]; then mkdir "$d"; chown 300:300 "$d"; chmod 755 "$d"; fi
            [ -d "$u/Maildir" ] && return 0
            if [ ! -d "$u" ]; then mkdir "$u"; chown 300:300 "$u"; chmod 755 "$u"; fi
            mkdir "$u/Maildir" "$u/Maildir/cur" "$u/Maildir/new" "$u/Maildir/tmp"
            chown 300:300 "$u/Maildir" "$u/Maildir/cur" "$u/Maildir/new" "$u/Maildir/tmp"
            chmod 700 "$u/Maildir" "$u/Maildir/cur" "$u/Maildir/new" "$u/Maildir/tmp"
            echo "created the maildir for $2@$1"
          }
          {%- for m in mailboxes %}
          {%- set p = m | split("@") | list %}
          mkmaildir {{ p[1] }} {{ p[0] }}
          {%- endfor %}
        volumeMounts:
        - name: courier-spool
          mountPath: /var/spool/courier
        - name: mail-storage
          mountPath: /vmail
        securityContext:
          runAsUser: 0
      containers:
      - name: courierd
        image: ghcr.io/pcn/mailbag/courier-courierd:{{ image.tag | default("main") }}
        imagePullPolicy: Always
        volumeMounts:
        - name: templates
          mountPath: /authdaemonrc.template
          subPath: authdaemonrc.template
        # Derived databases, read-only. Built and validated out of band by
        # build-courier-dat.sh; pods consume them and never build them.
        - name: courier-dat
          mountPath: /etc/courier/hosteddomains.dat
          subPath: hosteddomains.dat
          readOnly: true
        - name: courier-dat
          mountPath: /etc/courier/esmtpacceptmailfor.dat
          subPath: esmtpacceptmailfor.dat
          readOnly: true
        - name: courier-dat
          mountPath: /etc/courier/smtpaccess.dat
          subPath: smtpaccess.dat
          readOnly: true
        - name: courier-dat
          mountPath: /etc/courier/aliases.dat
          subPath: aliases.dat
          readOnly: true
        - name: courier-userdb
          mountPath: /etc/authlib/userdb.dat
          subPath: userdb.dat
          readOnly: true
        - name: courier-userdb
          mountPath: /etc/authlib/userdbshadow.dat
          subPath: userdbshadow.dat
          readOnly: true
        - name: courier-spool
          mountPath: /var/spool/courier
        - name: mail-storage
          mountPath: /vmail
        - name: courier-auth
          mountPath: /etc/authlib
        - name: context-json
          mountPath: /context.json
          readOnly: true
        readinessProbe:
          exec:
            command: ["/bin/sh", "-c", '/usr/local/bin/mailbag-probe']
          initialDelaySeconds: 10
          periodSeconds: 10
          timeoutSeconds: 10
          failureThreshold: 3
        livenessProbe:
          exec:
            command: ["/bin/sh", "-c", '/usr/local/bin/mailbag-probe']
          initialDelaySeconds: 60
          periodSeconds: 30
          timeoutSeconds: 10
          # Higher than readiness on purpose: readiness should pull the pod out
          # of the Service quickly, but restarting is the heavier hammer and
          # runit is already retrying underneath.
          failureThreshold: 5
        securityContext:
          privileged: true
      volumes:
      - name: templates
        configMap:
          name: mailbag-context
      - name: courier-dat
        # kustomize configMapGenerator gives this a content-hashed name and
        # rewrites the reference, so changed databases change the pod template
        # and the pods roll. couriertcpd holds smtpaccess.dat open for its
        # whole life, so a rollout is the only way new rules take effect.
        configMap:
          name: courier-dat
      - name: courier-userdb
        secret:
          # userdbshadow.dat is password hashes: Secret, not ConfigMap, and
          # group-readable via fsGroup rather than world-readable.
          secretName: courier-userdb
          defaultMode: 0440
      # Host directories from host_paths, created if missing; the init
      # container above sets their owner and mode (PROJ-011).
      - name: courier-spool
        hostPath:
          path: {{ host_paths.spool }}
          type: DirectoryOrCreate
      - name: mail-storage
        hostPath:
          path: {{ host_paths.mail }}
          type: DirectoryOrCreate
      - name: courier-auth
        # Per-pod. Only authdaemonrc is written here now; the userdb databases
        # arrive from the Secret and the userdb *source* is the build job's
        # business, not a serving pod's.
        emptyDir: {}
      - name: context-json
        hostPath:
          path: /etc/mailbag/context.json
          type: File
