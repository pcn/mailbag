apiVersion: apps/v1
kind: Deployment
metadata:
  name: courier-msa
  namespace: mailbag
  labels:
    app: mailbag
    component: msa
spec:
  replicas: 1
  # Recreate: this node has no headroom for a surge replica.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: mailbag
      component: msa
  template:
    metadata:
      labels:
        app: mailbag
        component: msa
    spec:
      securityContext:
        fsGroup: 1
        fsGroupChangePolicy: OnRootMismatch
      initContainers:
      - name: init-dirs
        # Pinned by digest: an init container that runs as root and chowns the mail
        # store is not somewhere to accept a mutable upstream tag.
        image: busybox:1.37.0@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0
        command: 
        - sh
        - -c
        - |
          mkdir -p /etc/courier/esmtpacceptmailfor.dir
          mkdir -p /etc/authlib/userdb
          chmod 700 /etc/authlib/userdb
          chown -R daemon:daemon /etc/courier
          chown -R daemon:daemon /etc/authlib
        volumeMounts:
        - name: courier-config
          mountPath: /etc/courier
        - name: courier-auth
          mountPath: /etc/authlib
        securityContext:
          runAsUser: 0
      containers:
      - name: courier-msa
        image: ghcr.io/pcn/mailbag/courier-msa:{{ image.tag | default("main") }}
        imagePullPolicy: Always
        ports:
        - containerPort: 587
          name: submission
        volumeMounts:
        # Derived databases, read-only. Built and validated out of band by
        # build-courier-dat.sh; pods consume them and never build them.
        - name: courier-dat
          mountPath: /etc/courier/hosteddomains.dat
          subPath: hosteddomains.dat
          readOnly: true
        - name: courier-dat
          mountPath: /etc/courier/esmtpacceptmailfor.dat
          subPath: esmtpacceptmailfor.dat
          readOnly: true
        - name: courier-dat
          mountPath: /etc/courier/smtpaccess.dat
          subPath: smtpaccess.dat
          readOnly: true
        - name: courier-dat
          mountPath: /etc/courier/aliases.dat
          subPath: aliases.dat
          readOnly: true
        - name: courier-userdb
          mountPath: /etc/authlib/userdb.dat
          subPath: userdb.dat
          readOnly: true
        - name: courier-userdb
          mountPath: /etc/authlib/userdbshadow.dat
          subPath: userdbshadow.dat
          readOnly: true
        - name: courier-spool
          mountPath: /var/spool/courier
        - name: mail-storage
          mountPath: /vmail
        - name: courier-config
          mountPath: /etc/courier
        - name: courier-auth
          mountPath: /etc/authlib
        - name: courier-cert
          mountPath: /certs
          readOnly: true
        - name: context-json
          mountPath: /context.json
          readOnly: true
        - name: templates
          mountPath: /acceptmailfor.template
          subPath: acceptmailfor.template
        - name: templates
          mountPath: /hosteddomains.template
          subPath: hosteddomains.template
        - name: templates
          mountPath: /esmtpd-base-msa.template
          subPath: esmtpd-base-msa.template
        - name: templates
          mountPath: /esmtpd-msa.template
          subPath: esmtpd-msa.template
        - name: templates
          mountPath: /smtpaccess-default.template
          subPath: smtpaccess-default.template
        - name: templates
          mountPath: /authdaemonrc.template
          subPath: authdaemonrc.template
        readinessProbe:
          exec:
            command: ["/bin/sh", "-c", '/usr/local/bin/mailbag-probe --port 587 --expect "220"']
          initialDelaySeconds: 10
          periodSeconds: 10
          timeoutSeconds: 10
          failureThreshold: 3
        livenessProbe:
          exec:
            command: ["/bin/sh", "-c", '/usr/local/bin/mailbag-probe --port 587 --expect "220"']
          initialDelaySeconds: 60
          periodSeconds: 30
          timeoutSeconds: 10
          # Higher than readiness on purpose: readiness should pull the pod out
          # of the Service quickly, but restarting is the heavier hammer and
          # runit is already retrying underneath.
          failureThreshold: 5
        securityContext:
          runAsUser: 1
          runAsGroup: 1
      volumes:
      - name: courier-dat
        # kustomize configMapGenerator gives this a content-hashed name and
        # rewrites the reference, so changed databases change the pod template
        # and the pods roll. couriertcpd holds smtpaccess.dat open for its
        # whole life, so a rollout is the only way new rules take effect.
        configMap:
          name: courier-dat
      - name: courier-userdb
        secret:
          # userdbshadow.dat is password hashes: Secret, not ConfigMap, and
          # group-readable via fsGroup rather than world-readable.
          secretName: courier-userdb
          defaultMode: 0440
      - name: courier-spool
        persistentVolumeClaim:
          claimName: courier-spool-pvc
      - name: mail-storage
        persistentVolumeClaim:
          claimName: mail-storage-pvc
      - name: courier-config
        # Per-pod, not shared. The entrypoint renders this pod's own esmtpd
        # configs here; the databases are mounted read-only on top. Sharing this
        # volume is what let pods overwrite each other's databases and orphan
        # each other's open descriptors -- three listeners were each holding a
        # different deleted smtpaccess.dat inode.
        emptyDir: {}
      - name: courier-auth
        # Per-pod. Only authdaemonrc is written here now; the userdb databases
        # arrive from the Secret and the userdb *source* is the build job's
        # business, not a serving pod's.
        emptyDir: {}
      - name: courier-cert
        secret:
          secretName: courier-mail-cert-tls
          # Readable by the service group, never world-readable. Ownership comes
          # from the pod fsGroup below; Secret volumes are root-owned otherwise.
          defaultMode: 0440
      - name: context-json
        hostPath:
          path: /etc/mailbag/context.json
          type: File
      - name: templates
        configMap:
          name: mailbag-context
---
apiVersion: v1
kind: Service
metadata:
  name: msa
  namespace: mailbag
  labels:
    app: mailbag
    component: msa
spec:
  selector:
    app: mailbag
    component: msa
  ports:
  - port: 587
    targetPort: submission
    protocol: TCP
    name: submission
  type: LoadBalancer
